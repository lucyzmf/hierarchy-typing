# Copy to .env, adjust, then `set -a; source .env; set +a` before running.
# Only PINET_DATA_PATH is required; everything else has a default.
# None of the PINET_* settings is part of any cache key; DEVICE and RUN_MODE select
# which experiments run.

# dataset root (the folder that contains MEG/ and EEG/)
PINET_DATA_PATH=/path/to/dataset
# exca cache root (results, preprocessed data, event tables)
PINET_CACHE_PATH=./cache/pinet_archive

# where jobs run: auto (slurm if available, else local) | slurm | local | processpool | none (in-process)
PINET_CLUSTER=auto
# PINET_SLURM_PARTITION=
PINET_CPUS=4
PINET_MEM_GB=12
PINET_FEATURE_MEM_GB=32
# feature extraction runs once (a few hundred words / syllables, then cached);
# each parallel job loads the model again (fastText: 7 GB), so keep this at 1
PINET_FEATURE_MAX_JOBS=1
PINET_MAX_JOBS=24
# parallel preprocessing jobs (one per recording); lower this on a single machine
PINET_DEVICE_MAX_JOBS=84
PINET_TIMEOUT_MIN=4320

# Meg | Eeg
DEVICE=Meg
# all | test (one recording, 0.1 s window: quick smoke test)
RUN_MODE=all
